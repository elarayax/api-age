{
    "swagger": "2.0",
    "info": {
        "description": "API REST para gestionar civilizaciones de Age of Empires II.",
        "title": "AoE2 Civilizations API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/api/v1",
    "paths": {
        "/civilizations": {
            "get": {
                "description": "Retorna la lista completa de civilizaciones guardadas",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Civilizaciones"
                ],
                "summary": "Obtener todas las civilizaciones",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/main.Civilization"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/main.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "Agrega una nueva civilización a la base de datos",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Civilizaciones"
                ],
                "summary": "Crear una civilización",
                "parameters": [
                    {
                        "description": "Datos de la civilización",
                        "name": "civilization",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.Civilization"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/main.Civilization"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/main.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/civilizations/{id}": {
            "get": {
                "description": "Busca y retorna una civilización específica",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Civilizaciones"
                ],
                "summary": "Obtener una civilización por ID",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID de la Civilización",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.Civilization"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/main.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/main.ErrorResponse"
                        }
                    }
                }
            },
            "put": {
                "description": "Actualiza todos los campos de una civilización por su ID",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Civilizaciones"
                ],
                "summary": "Reemplazar completamente una civilización (PUT)",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID de la Civilización",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Nuevos datos completos",
                        "name": "civilization",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.Civilization"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.Civilization"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/main.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/main.ErrorResponse"
                        }
                    }
                }
            },
            "delete": {
                "description": "Borra una civilización de la base de datos por su ID",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Civilizaciones"
                ],
                "summary": "Eliminar una civilización",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID de la Civilización",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.MessageResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/main.ErrorResponse"
                        }
                    }
                }
            },
            "patch": {
                "description": "Actualiza solo los campos enviados en el cuerpo JSON",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Civilizaciones"
                ],
                "summary": "Actualizar parcialmente una civilización (PATCH)",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID de la Civilización",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Campos a actualizar (ej: {\\",
                        "name": "fields",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "object"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.Civilization"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/main.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/main.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "main.Civilization": {
            "type": "object",
            "properties": {
                "class": {
                    "type": "string",
                    "example": "Arqueros"
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "name": {
                    "type": "string",
                    "example": "Británicos"
                },
                "specialty": {
                    "type": "string",
                    "example": "Alcance extra en sus arqueros"
                },
                "unique_unit": {
                    "type": "string",
                    "example": "Arquero de tiro largo"
                }
            }
        },
        "main.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "Civilización no encontrada"
                }
            }
        },
        "main.MessageResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Operación exitosa"
                }
            }
        }
    }
}